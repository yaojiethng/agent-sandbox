{
  "note": "The container interface, declared once. src/build/container-interface.mjs is the only reader, and scripts/check_container_layout.sh holds this file equal to the COPY and ENV lines in the provider dockerfiles, both directions. The `session` rows are the environment of a session in a container: every instruction surface is read from that environment, so no cell restates them. A `cell` is one instruction surface. The `mount` layer is not here: the compose files declare it host-side, and this container cannot read them.",
  "image": [
    { "provider": "pi", "source": "src/libs/", "destination": "/opt/sandbox/lib/" },
    { "provider": "pi", "source": "src/reasoning/entrypoint.sh", "destination": "/opt/sandbox/bin/provider-entrypoint.sh" },
    { "provider": "pi", "source": "src/reasoning/providers/pi/preflight.sh", "destination": "/opt/sandbox/bin/provider-preflight.sh" },
    { "provider": "pi", "source": "src/reasoning/agent/skills/", "destination": "/opt/workflow/agent/skills/" },
    { "provider": "pi", "source": "src/reasoning/agent/prompts/", "destination": "/opt/workflow/agent/prompts/" },
    { "provider": "pi", "source": "workflow/coding-agent/prompts/", "destination": "/opt/workflow/agent/modules/coding-agent/prompts/" },
    { "provider": "pi", "source": "workflow/coding-agent/skills/", "destination": "/opt/workflow/agent/modules/coding-agent/skills/" },
    { "provider": "pi", "source": "src/reasoning/providers/pi/config/", "destination": "/opt/workflow/agent/config/" },
    { "provider": "pi", "source": "docs/architecture/", "destination": "/opt/sandbox/docs/architecture/" },
    { "provider": "pi", "source": "docs/concepts/", "destination": "/opt/sandbox/docs/concepts/" },
    { "provider": "pi", "source": "docs/operations/", "destination": "/opt/sandbox/docs/operations/" },

    { "provider": "hermes", "source": "src/libs/", "destination": "/opt/sandbox/lib/" },
    { "provider": "hermes", "source": "src/reasoning/entrypoint.sh", "destination": "/opt/sandbox/bin/provider-entrypoint.sh" },
    { "provider": "hermes", "source": "src/reasoning/agent/skills/", "destination": "/opt/workflow/agent/skills/" },
    { "provider": "hermes", "source": "src/reasoning/agent/prompts/", "destination": "/opt/workflow/agent/prompts/" },
    { "provider": "hermes", "source": "workflow/coding-agent/prompts/", "destination": "/opt/workflow/agent/modules/coding-agent/prompts/" },
    { "provider": "hermes", "source": "workflow/coding-agent/skills/", "destination": "/opt/workflow/agent/modules/coding-agent/skills/" },
    { "provider": "hermes", "source": "docs/architecture/", "destination": "/opt/sandbox/docs/architecture/" },
    { "provider": "hermes", "source": "docs/concepts/", "destination": "/opt/sandbox/docs/concepts/" },
    { "provider": "hermes", "source": "docs/operations/", "destination": "/opt/sandbox/docs/operations/" },

    { "provider": "opencode", "source": "src/libs/", "destination": "/opt/sandbox/lib/" },
    { "provider": "opencode", "source": "src/reasoning/entrypoint.sh", "destination": "/opt/sandbox/bin/provider-entrypoint.sh" },
    { "provider": "opencode", "source": "src/reasoning/agent/skills/", "destination": "/opt/workflow/agent/skills/" },
    { "provider": "opencode", "source": "src/reasoning/agent/prompts/", "destination": "/opt/workflow/agent/prompts/" },
    { "provider": "opencode", "source": "workflow/coding-agent/prompts/", "destination": "/opt/workflow/agent/modules/coding-agent/prompts/" },
    { "provider": "opencode", "source": "workflow/coding-agent/skills/", "destination": "/opt/workflow/agent/modules/coding-agent/skills/" },
    { "provider": "opencode", "source": "docs/architecture/", "destination": "/opt/sandbox/docs/architecture/" },
    { "provider": "opencode", "source": "docs/concepts/", "destination": "/opt/sandbox/docs/concepts/" },
    { "provider": "opencode", "source": "docs/operations/", "destination": "/opt/sandbox/docs/operations/" }
  ],
  "provision": [
    {
      "provider": "pi",
      "source": "src/reasoning/providers/pi/config/",
      "template": "/opt/workflow/agent/config/",
      "home": "$AGENT_HOME/"
    }
  ],
  "env": [
    { "provider": "pi", "name": "AGENT_HOME", "value": "/home/agentuser/.pi" },
    { "provider": "pi", "name": "PROVIDER_NAME", "value": "pi" },
    { "provider": "pi", "name": "WORKSPACE_DIR", "value": "/home/agentuser/workspace" },
    { "provider": "pi", "name": "PATH", "value": "/opt/sandbox/bin:$PATH" },

    { "provider": "hermes", "name": "AGENT_HOME", "value": "/home/agentuser/.hermes" },
    { "provider": "hermes", "name": "PROVIDER_NAME", "value": "hermes" },
    { "provider": "hermes", "name": "PATH", "value": "/opt/sandbox/bin:$PATH" },

    { "provider": "opencode", "name": "AGENT_HOME", "value": "/home/agentuser/.opencode" },
    { "provider": "opencode", "name": "PROVIDER_NAME", "value": "opencode" },
    { "provider": "opencode", "name": "PATH", "value": "/opt/sandbox/bin:$PATH" }
  ],
  "session": [
    { "path": "/home/agentuser/sandbox/", "holds": "the project tree, and the working directory" },
    { "path": "/home/agentuser/workspace/input/", "holds": "the operator's handover files, read-only" },
    { "path": "/home/agentuser/workspace/output/", "holds": "where the agent writes its result" },
    { "path": "/home/agentuser/workspace/session-diffs/", "holds": "the session diff output" },
    { "path": "/opt/workflow/agent/prompts/", "holds": "the harness prompt root" },
    { "path": "/opt/workflow/agent/skills/", "holds": "the harness skill root" },
    { "path": "/opt/sandbox/docs/architecture/", "holds": "the harness architecture documents" },
    { "path": "/opt/sandbox/docs/concepts/", "holds": "the harness concept documents" },
    { "path": "/opt/sandbox/docs/operations/", "holds": "the operations policy corpus, bundled from `docs/operations/`" },
    { "path": "/opt/sandbox/lib/", "holds": "the harness libraries" },
    { "path": "/opt/sandbox/bin/", "holds": "the entrypoint and preflight scripts" },
    { "path": "$AGENT_HOME/", "holds": "the running provider's config home, seeded from its template at every start" }
  ],
  "cells": [
    {
      "sources": ["src/reasoning/agent/prompts/"],
      "runtime_path": "/opt/workflow/agent/prompts/",
      "loader": "the running provider's config lists this path as a prompt root, and the agent offers each Markdown file here as a command"
    },
    {
      "sources": ["src/reasoning/agent/skills/"],
      "runtime_path": "/opt/workflow/agent/skills/",
      "loader": "the running provider's config lists this path as a skill root, and the agent loads a skill's SKILL.md and any sibling file that skill names",
      "reachable": [
        { "path": "src/reasoning/providers/", "holds": "the harness's provider sources, one folder per provider", "condition": "the reader has the repository tree" }
      ]
    },
    {
      "sources": ["workflow/coding-agent/prompts/"],
      "runtime_path": "/opt/workflow/agent/modules/coding-agent/prompts/",
      "loader": "the running provider's config enables the module's package directory, whose prompts folder contributes every Markdown file here as a command",
      "reachable": [
        { "path": "devlog/", "holds": "the records the workflow prompts read and write", "condition": "the reader has the repository tree" }
      ]
    },
    {
      "sources": ["workflow/coding-agent/skills/"],
      "runtime_path": "/opt/workflow/agent/modules/coding-agent/skills/",
      "loader": "the running provider's config enables the module's package directory, whose skills folder contributes a skill per directory holding SKILL.md",
      "reachable": [
        { "path": "devlog/", "holds": "the roadmap and the handover chain the maintenance skills read", "condition": "the reader has the repository tree" }
      ]
    },
    {
      "sources": ["src/reasoning/providers/pi/config/"],
      "runtime_path": "$AGENT_HOME/",
      "loader": "pi reads its config home at startup: the agent AGENTS.md, the settings record, the auth record and the model list",
      "provider": "pi",
      "reachable": [
        { "path": "/opt/workflow/agent/config/", "holds": "the config template this home is seeded from at every start", "condition": "pi delivery" },
        { "path": "/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/", "holds": "the pi install, its changelog and its documentation", "condition": "pi delivery" }
      ]
    },
    {
      "sources": ["src/reasoning/providers/pi/config/agent/prompts/"],
      "runtime_path": "$AGENT_HOME/agent/prompts/",
      "loader": "pi reads its prompt root from the agent home, which the host bind-mounts for prompts and the image seeds from its config template at every start",
      "provider": "pi",
      "reachable": [
        { "path": "/opt/workflow/agent/config/", "holds": "the config template this folder is provisioned from at every start", "condition": "pi delivery" },
        { "path": "/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/", "holds": "the pi install and its documentation, under npm's global prefix", "condition": "pi delivery" }
      ]
    },
    {
      "sources": ["src/reasoning/providers/pi/config/agent/skills/"],
      "runtime_path": "$AGENT_HOME/agent/skills/",
      "loader": "pi scans its user skills directory at startup, and that directory is bind-mounted from the host and seeded from the image's config template",
      "provider": "pi",
      "reachable": [
        { "path": "/opt/workflow/agent/config/", "holds": "the config template this folder is seeded from at every start", "condition": "pi delivery" },
        { "path": "/usr/local/lib/node_modules/@earendil-works/pi-coding-agent/", "holds": "the pi install, its changelog and its documentation", "condition": "pi delivery" },
        { "path": "src/reasoning/providers/pi/", "holds": "the harness's pi provider sources, which the bump skill edits", "condition": "the reader has the repository tree" }
      ]
    }
  ]
}
