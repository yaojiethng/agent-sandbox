{
  "lastChangelogVersion": "1.1.0",
  "defaultProjectTrust": "always",
  "defaultProvider": "opencode-go",
  "defaultModel": "step-5-preview-free",
  "defaultThinkingLevel": "high",
  "followUpMode": "all",
  "tuiMode": "regular",
  "enablePromptCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 13,
    "baseDelayMs": 1000,
    "maxAgentDelayMs": 3600000
  },
  "tools": {
    "web_fetch": {
      "enabled": true,
      "max_content_tokens": 50000,
      "dynamic_filtering": true
    }
  },
  "packages": [
    "/opt/workflow/agent",
    "/opt/workflow/agent/modules/coding-agent"
  ],
  "enabledModels": [
    "opencode-go/step-5-preview-free",
    "opencode-go/*",
    "opencode/*-free",
    "deepseek/*",
    "openrouter/deepseek/*",
    "openrouter/z-ai/*",
    "openrouter/qwen/*"
  ],
  "hideThinkingBlock": false
}
