{
  "lastChangelogVersion": "1.0.0",
  "defaultProjectTrust": "always",
  "defaultProvider": "opencode-go",
  "defaultModel": "space-bunny-free",
  "defaultThinkingLevel": "low",
  "followUpMode": "all",
  "enablePromptCommands": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 20000
  },
  "tools": {
    "web_fetch": {
      "enabled": true,
      "max_content_tokens": 50000,
      "dynamic_filtering": true
    }
  },
  "packages": [
    "/opt/workflow/agent"
  ],
  "enabledModels": [
    "opencode-go/space-bunny-free",
    "opencode-go/*",
    "opencode/*-free",
    "deepseek/*",
    "openrouter/deepseek/*",
    "openrouter/z-ai/*",
    "openrouter/qwen/*"
  ],
  "hideThinkingBlock": false,
  "skills": [
    "/opt/workflow/agent/skills"
  ],
  "prompts": [
    "/opt/workflow/agent/prompts"
  ]
}
