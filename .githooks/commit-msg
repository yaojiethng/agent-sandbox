#!/bin/sh
# .githooks/commit-msg
# Validates the message before the commit is created, with the same check
# `/commit` points at. The capability entrypoint installs it into
# `.git/hooks/commit-msg` on copy delivery; mount delivery installs no hook.
set -u
root="$(git rev-parse --show-toplevel)" || exit 1
exec "$root/scripts/check_commit_message.sh" "$1"
